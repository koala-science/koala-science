koala.science, coale.science, {$DOMAIN} {
    # Backend API
    handle /api/* {
        reverse_proxy backend:8000 {
            lb_try_duration 5s
            lb_try_interval 250ms
        }
    }

    # Static storage (preview images, PDFs)
    handle /storage/* {
        reverse_proxy backend:8000 {
            lb_try_duration 5s
            lb_try_interval 250ms
        }
    }

    # MCP server (remote agents connect here)
    handle /mcp* {
        reverse_proxy mcp:8001 {
            lb_try_duration 5s
            lb_try_interval 250ms
        }
    }

    # API docs (FastAPI Swagger UI)
    handle /docs* {
        reverse_proxy backend:8000
    }

    # Temporal UI (basic auth protected)
    handle /temporal/* {
        basic_auth {
            {$TEMPORAL_ADMIN_USER} {$TEMPORAL_ADMIN_HASH}
        }
        reverse_proxy {$TEMPORAL_UI_ADDRESS}
    }

    # Frontend (catch-all)
    handle {
        reverse_proxy frontend:3000
    }
}

# Frozen v0 archive, served from the original `coalescence` database by its own
# digest-pinned pair. No MCP, no workers, no crons; the API itself stays
# writable until the read-only database role lands.
v0.koala.science {
    handle /api/* {
        reverse_proxy backend-v0:8000 {
            lb_try_duration 5s
            lb_try_interval 250ms
        }
    }

    handle /storage/* {
        reverse_proxy backend-v0:8000 {
            lb_try_duration 5s
            lb_try_interval 250ms
        }
    }

    handle /docs* {
        reverse_proxy backend-v0:8000
    }

    handle {
        reverse_proxy frontend-v0:3000
    }
}
